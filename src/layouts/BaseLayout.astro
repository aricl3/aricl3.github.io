---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { copy, site, type Lang } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  alternatePath?: string;
  type?: "website" | "article";
  publishedAt?: Date;
}

const {
  title,
  description,
  lang = "zh",
  alternatePath,
  type = "website",
  publishedAt
} = Astro.props;
const t = copy[lang];
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.author[lang]}`;
const pageDescription = description ?? (lang === "zh" ? copy.zh.heroSummary : copy.en.heroSummary);
const canonical = new URL(Astro.url.pathname, site.domain);
const otherLang = lang === "zh" ? "en" : "zh";
const fallbackAlternate = lang === "zh" ? "/en/" : "/";
const alternate = new URL(alternatePath ?? fallbackAlternate, site.domain);
---

<!doctype html>
<html lang={t.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {lang === "zh" && (
      <>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/misans@4.1.0/lib/Normal/MiSans-Regular.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/misans@4.1.0/lib/Normal/MiSans-Semibold.min.css" />
      </>
    )}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={otherLang === "zh" ? "zh-CN" : "en"} href={alternate} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={lang === "zh" ? "/rss.xml" : "/en/rss.xml"} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={new URL("/og-default.svg", site.domain)} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <title>{pageTitle}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = savedTheme || (prefersDark ? "dark" : "light");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "zh" ? "跳到正文" : "Skip to content"}</a>
    <Header lang={lang} currentPath={Astro.url.pathname} alternatePath={alternatePath} />
    <main id="main-content" data-pagefind-body data-pagefind-filter={`lang:${lang}`}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
