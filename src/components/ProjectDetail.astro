---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pathFor, type Lang } from "@/data/site";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  alternatePath: string;
}

const { project, lang, alternatePath } = Astro.props;
const { Content, headings } = await render(project);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const labels = lang === "zh"
  ? { back: "返回项目", role: "角色", period: "周期", status: "状态", toc: "案例目录" }
  : { back: "Back to projects", role: "Role", period: "Period", status: "Status", toc: "Case outline" };
const caseNumber = String(project.data.order).padStart(2, "0");
---

<BaseLayout title={project.data.title} description={project.data.summary} lang={lang} alternatePath={alternatePath} type="article">
  <article class="note-article project-detail section-shell">
    <a class="back-link" href={`${pathFor(lang, "projects")}/`}>← {labels.back}</a>
    <header>
      <p class="section-index">CASE STUDY / {caseNumber}</p>
      <h1 data-pagefind-meta="title">{project.data.title}</h1>
      <p class="note-dek">{project.data.summary}</p>
      <dl class="project-detail__facts">
        <div><dt>{labels.role}</dt><dd>{project.data.role}</dd></div>
        <div><dt>{labels.period}</dt><dd>{project.data.period ?? "—"}</dd></div>
        <div><dt>{labels.status}</dt><dd>{project.data.status ?? "—"}</dd></div>
        {project.data.metrics.map((metric) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}
      </dl>
      <div class="tag-row" aria-label="Technology stack">{project.data.stack.map((item) => <span>{item}</span>)}</div>
      {project.data.links.length > 0 && (
        <div class="project-detail__links">
          {project.data.links.map((link) => <a class="text-link" href={link.href} rel="noreferrer">{link.label} ↗</a>)}
        </div>
      )}
    </header>
    <div class="article-layout">
      <div class="prose"><Content /></div>
      {toc.length > 0 && (
        <aside class="toc">
          <strong>{labels.toc}</strong>
          <ol>{toc.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail__facts {
    display: flex;
    max-width: 820px;
    padding: 1.2rem 0;
    margin: 2rem auto 1.2rem;
    justify-content: center;
    gap: clamp(1.4rem, 4vw, 3.5rem);
    border-block: 1px solid var(--line);
  }

  .project-detail__facts div { min-width: 0; }
  .project-detail__facts dt { color: var(--muted); font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .project-detail__facts dd { margin: .25rem 0 0; font-weight: 750; }
  .project-detail__links { display: flex; margin-top: 1.2rem; justify-content: center; gap: 1rem; }
  .project-detail :global(.prose strong) {
    color: var(--accent);
    font-family: var(--sans);
    font-size: .94em;
    font-weight: 780;
    letter-spacing: -.012em;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--warm) 42%, transparent);
    text-decoration-thickness: .16em;
    text-underline-offset: .18em;
  }

  @media (max-width: 700px) {
    .project-detail__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); text-align: left; }
  }
</style>
