---
import type { CollectionEntry } from "astro:content";
import { pathFor, type Lang } from "@/data/site";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  index?: number;
}

const { project, lang, index = 1 } = Astro.props;
const projectSlug = project.id.split("/").at(-1);
const detailPath = pathFor(lang, `projects/${projectSlug}/`);
const destination = project.data.caseStudy ? detailPath : pathFor(lang, "projects");
const viewLabel = project.data.caseStudy
  ? (lang === "zh" ? "查看案例" : "View case")
  : (lang === "zh" ? "查看项目" : "View project");
const labels = lang === "zh"
  ? { role: "角色", period: "周期", domain: "领域", status: "状态" }
  : { role: "Role", period: "Period", domain: "Domain", status: "Status" };
const caseNumber = String(index).padStart(2, "0");
const projectCode = project.data.translationKey.split("-").map((part) => part[0]).join("").slice(0, 4).toUpperCase();
---

<a class="case-pass-shell" href={destination} aria-label={`${viewLabel}: ${project.data.title}`}>
  <article class="case-pass">
    <div class="case-pass__main">
      <div class="case-pass__grid" aria-hidden="true"></div>
      <div class="case-pass__content">
        <header class="case-pass__header">
          <span class="case-pass__brand"><i>R</i> ROCKY</span>
          <span class="case-pass__type">CASE / {caseNumber}</span>
        </header>
        <h3>{project.data.title}</h3>
        <p class="case-pass__summary">{project.data.summary}</p>
        <div class="case-pass__details">
          <div><small>{labels.role}</small><strong>{project.data.role}</strong></div>
          <div><small>{labels.period}</small><strong>{project.data.period ?? "—"}</strong></div>
          <div><small>{labels.domain}</small><strong>{project.data.domain ?? project.data.stack.slice(0, 2).join(" · ")}</strong></div>
          <div><small>{labels.status}</small><strong>{project.data.status ?? "—"}</strong></div>
        </div>
        {project.data.metrics.length > 0 && (
          <div class="case-pass__metrics">
            {project.data.metrics.map((metric) => <span><small>{metric.label}</small><strong>{metric.value}</strong></span>)}
          </div>
        )}
      </div>
    </div>
    <div class="case-pass__tear" aria-hidden="true"><span></span></div>
    <footer class="case-pass__stub">
      <div>
        <span class="case-pass__barcode" aria-hidden="true"></span>
        <small>R-{caseNumber}-{projectCode}-2026</small>
      </div>
      <strong>{viewLabel} <span aria-hidden="true">→</span></strong>
    </footer>
  </article>
</a>

<style>
  .case-pass-shell {
    display: block;
    min-width: 0;
    perspective: 1000px;
  }

  .case-pass {
    position: relative;
    height: 100%;
    min-height: 540px;
    color: var(--ink);
    filter: drop-shadow(0 24px 28px rgb(47 48 42 / 12%));
    transform-style: preserve-3d;
    transition: transform 500ms cubic-bezier(.2,.75,.25,1), filter 500ms ease;
  }

  .case-pass__main {
    position: relative;
    min-height: 428px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    background:
      radial-gradient(circle at 0 100%, transparent 15px, var(--paper-raised) 16px),
      radial-gradient(circle at 100% 100%, transparent 15px, var(--paper-raised) 16px);
    background-position: bottom left, bottom right;
    background-repeat: no-repeat;
    background-size: 51% 100%;
  }

  .case-pass__grid {
    position: absolute;
    inset: -30%;
    background-image:
      linear-gradient(color-mix(in srgb, var(--accent) 13%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 13%, transparent) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: .72;
    transform: perspective(520px) rotateX(14deg) scale(1.22);
  }

  .case-pass__main::after {
    position: absolute;
    inset: 0;
    z-index: 3;
    content: "";
    background: linear-gradient(115deg, transparent 32%, rgb(255 255 255 / 24%) 48%, transparent 62%);
    background-position: 130% 100%;
    background-size: 230% 230%;
    mix-blend-mode: soft-light;
    pointer-events: none;
    transition: background-position 550ms ease;
  }

  .case-pass__content { position: relative; z-index: 2; padding: clamp(1.5rem, 3vw, 2rem); }
  .case-pass__header { display: flex; margin-bottom: 2.2rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .case-pass__brand { display: flex; align-items: center; gap: .55rem; font-size: .78rem; font-weight: 850; letter-spacing: .08em; }
  .case-pass__brand i { display: grid; width: 28px; height: 28px; border-radius: 50%; place-items: center; background: var(--ink); color: var(--paper); font-family: var(--serif); font-style: normal; }
  .case-pass__type { padding: .3rem .65rem; border: 1px solid var(--warm); border-radius: 999px; color: var(--warm); font-size: .62rem; font-weight: 800; letter-spacing: .14em; }
  .case-pass h3 { max-width: 430px; margin: 0; font-family: var(--display); font-size: clamp(1.85rem, 3.4vw, 3rem); font-weight: 560; letter-spacing: -.045em; line-height: .98; }
  :global(html:lang(zh-CN)) .case-pass h3 { font-weight: 400; letter-spacing: .02em; line-height: 1.14; }
  .case-pass__summary { max-width: 580px; margin: 1rem 0 2.2rem; color: var(--muted); font-size: .92rem; line-height: 1.55; }

  .case-pass__details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem 1.5rem; }
  .case-pass__details div,
  .case-pass__metrics span { display: flex; min-width: 0; flex-direction: column; gap: .15rem; }
  .case-pass__details small,
  .case-pass__metrics small,
  .case-pass__stub small { color: var(--muted); font-size: .58rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .case-pass__details strong { font-size: .84rem; line-height: 1.35; }
  .case-pass__metrics { display: flex; margin-top: 1.5rem; gap: 1.7rem; }
  .case-pass__metrics strong { color: var(--accent); font-size: 1.05rem; }

  .case-pass__tear { position: relative; z-index: 4; height: 18px; background: var(--paper); }
  .case-pass__tear::before,
  .case-pass__tear::after { position: absolute; top: -1px; width: 17px; height: 20px; content: ""; border-radius: 50%; background: var(--paper); }
  .case-pass__tear::before { left: -8px; }
  .case-pass__tear::after { right: -8px; }
  .case-pass__tear span { position: absolute; top: 8px; right: 18px; left: 18px; border-top: 1px dashed color-mix(in srgb, var(--ink) 24%, transparent); }

  .case-pass__stub {
    display: flex;
    min-height: 96px;
    padding: 1.2rem 1.6rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 16px 16px;
    background:
      radial-gradient(circle at 0 0, transparent 15px, color-mix(in srgb, var(--accent-soft) 70%, var(--paper-raised)) 16px),
      radial-gradient(circle at 100% 0, transparent 15px, color-mix(in srgb, var(--accent-soft) 70%, var(--paper-raised)) 16px);
    background-position: top left, top right;
    background-repeat: no-repeat;
    background-size: 51% 100%;
  }

  .case-pass__stub > div { display: flex; flex-direction: column; gap: .4rem; }
  .case-pass__stub > strong { color: var(--accent); font-size: .83rem; }
  .case-pass__barcode { display: block; width: 118px; height: 28px; background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 5px, var(--ink) 5px 6px, transparent 6px 9px, var(--ink) 9px 13px, transparent 13px 16px); opacity: .76; }

  @media (hover: hover) and (pointer: fine) {
    .case-pass-shell:hover .case-pass { filter: drop-shadow(16px 30px 34px rgb(47 48 42 / 16%)); transform: rotateX(2.5deg) rotateY(-3.5deg) translateY(-4px); }
    .case-pass-shell:hover .case-pass__main::after { background-position: -20% 0; }
  }

  .case-pass-shell:focus-visible { border-radius: 16px; outline: 3px solid var(--warm); outline-offset: 5px; }

  @media (max-width: 640px) {
    .case-pass { min-height: 520px; }
    .case-pass__main { min-height: 408px; }
    .case-pass__header { margin-bottom: 1.7rem; }
    .case-pass__details { grid-template-columns: 1fr 1fr; }
    .case-pass__stub { padding-inline: 1.2rem; }
    .case-pass__barcode { width: 92px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-pass,
    .case-pass__main::after { transition: none; }
  }
</style>
