---
import { copy, site, type Lang } from "@/data/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {new Date().getFullYear()} {site.author[lang]}. {copy[lang].footer}</p>
    <div>
      <a href={site.github} rel="me noreferrer">GitHub</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</footer>
