---
import RockySprite from "@/components/RockySprite.astro";
import { pathFor, site, type Lang } from "@/data/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const text = lang === "zh" ? {
  label: "个人原则",
  role: "AI Agent 工程师",
  principle: "独立思考，持续构建。",
  about: "关于我"
} : {
  label: "Personal principle",
  role: "AI Agent Engineer",
  principle: "Think independently. Keep building.",
  about: "About"
};
---

<aside class="profile-depth-shell" data-profile-depth aria-label={text.label}>
  <div class="profile-depth-card">
    <div class="profile-depth-film" aria-hidden="true"></div>
    <div class="profile-depth-rings" aria-hidden="true">
      <span></span><span></span><span></span><strong>R</strong>
    </div>
    <div class="profile-depth-copy">
      <p class="profile-depth-index">01 / PROFILE</p>
      <small>{text.role}</small>
      <p class="profile-depth-principle">{text.principle}</p>
    </div>
    <div class="profile-depth-links">
      <a href={site.github} rel="me noreferrer">GitHub</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={pathFor(lang, "about")}>{text.about} <span aria-hidden="true">→</span></a>
    </div>
    <div class="profile-depth-pet"><RockySprite /></div>
  </div>
</aside>

<script>
  const canTilt = window.matchMedia("(hover: hover) and (pointer: fine)").matches
    && !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canTilt) {
    document.querySelectorAll<HTMLElement>("[data-profile-depth]").forEach((shell) => {
      const card = shell.querySelector<HTMLElement>(".profile-depth-card");
      if (!card) return;

      shell.addEventListener("pointermove", (event) => {
        const rect = shell.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty("--tilt-x", `${(-y * 14).toFixed(2)}deg`);
        card.style.setProperty("--tilt-y", `${(x * 16).toFixed(2)}deg`);
      });

      shell.addEventListener("pointerleave", () => {
        card.style.setProperty("--tilt-x", "0deg");
        card.style.setProperty("--tilt-y", "0deg");
      });
    });
  }
</script>

<style>
  .profile-depth-shell {
    width: min(100%, 286px);
    perspective: 1100px;
    align-self: end;
  }

  .profile-depth-card {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    position: relative;
    min-height: 330px;
    overflow: visible;
    border: 1px solid color-mix(in srgb, var(--line) 80%, var(--accent));
    border-radius: 16px;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--paper-raised) 96%, white), color-mix(in srgb, var(--accent-soft) 62%, var(--paper-raised)));
    box-shadow: 0 26px 55px rgb(47 48 42 / 13%);
    transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    transition: transform 420ms cubic-bezier(.2,.75,.25,1), box-shadow 420ms ease;
    will-change: transform;
  }

  .profile-depth-shell:hover .profile-depth-card {
    box-shadow: 12px 32px 65px rgb(47 48 42 / 17%);
  }

  .profile-depth-film {
    position: absolute;
    inset: 9px;
    border: 1px solid color-mix(in srgb, white 65%, transparent);
    border-right-color: transparent;
    border-top-color: color-mix(in srgb, white 82%, transparent);
    border-radius: 12px 42px 12px 12px;
    background: linear-gradient(165deg, rgb(255 255 255 / 26%), transparent 58%);
    pointer-events: none;
    transform: translateZ(14px);
  }

  .profile-depth-rings {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 116px;
    height: 116px;
    transform-style: preserve-3d;
  }

  .profile-depth-rings span,
  .profile-depth-rings strong {
    position: absolute;
    display: grid;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    border-radius: 50%;
    place-items: center;
  }

  .profile-depth-rings span:nth-child(1) { inset: 0; background: color-mix(in srgb, var(--accent-soft) 32%, transparent); transform: translateZ(18px); }
  .profile-depth-rings span:nth-child(2) { inset: 17px; transform: translateZ(30px); }
  .profile-depth-rings span:nth-child(3) { inset: 34px; background: color-mix(in srgb, var(--paper-raised) 54%, transparent); transform: translateZ(43px); }
  .profile-depth-rings strong { inset: 44px; border: 0; background: var(--ink); color: var(--paper); font-family: var(--serif); transform: translateZ(58px); }

  .profile-depth-copy {
    position: relative;
    z-index: 2;
    padding: 28px 24px;
    transform: translateZ(30px);
  }

  .profile-depth-index {
    margin: 0 0 66px;
    color: var(--warm);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .profile-depth-copy small {
    color: var(--muted);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .profile-depth-principle {
    max-width: 190px;
    margin: .55rem 0 0;
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.35;
  }

  .profile-depth-links {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: .8rem;
    font-size: .72rem;
    font-weight: 750;
    transform: translateZ(38px);
  }

  .profile-depth-links a { color: var(--accent); }
  .profile-depth-links a:last-child { margin-left: auto; }
  .profile-depth-links a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .profile-depth-pet {
    position: absolute;
    right: -28px;
    bottom: 42px;
    z-index: 4;
    transform: translateZ(54px);
    transition: transform 350ms ease;
  }

  .profile-depth-shell:hover .profile-depth-pet { transform: translate3d(0, -7px, 66px); }

  @media (max-width: 900px) {
    .profile-depth-shell { width: min(100%, 310px); justify-self: end; }
  }

  @media (max-width: 640px) {
    .profile-depth-shell { justify-self: start; }
    .profile-depth-card { min-height: 290px; }
    .profile-depth-index { margin-bottom: 52px; }
    .profile-depth-pet { right: 12px; bottom: 48px; }
  }

  @media (hover: none), (pointer: coarse) {
    .profile-depth-card { transform: rotateX(1deg) rotateY(-1.5deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-depth-card,
    .profile-depth-pet { transform: none; transition: none; }
  }
</style>
